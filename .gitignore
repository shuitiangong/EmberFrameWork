# Repository-level ignores for the Unity project in /EmberFrameWork/.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/EmberFrameWork/[Ll]ibrary/
/EmberFrameWork/[Tt]emp/
/EmberFrameWork/[Oo]bj/
/EmberFrameWork/[Bb]uild/
/EmberFrameWork/[Bb]uilds/
/EmberFrameWork/[Ll]ogs/
# /EmberFrameWork/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/EmberFrameWork/[Mm]emoryCaptures/

# Recordings can get excessive in size
/EmberFrameWork/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /EmberFrameWork/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/EmberFrameWork/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/EmberFrameWork/ServerData
/EmberFrameWork/[Aa]ssets/StreamingAssets/aa*
/EmberFrameWork/[Aa]ssets/AddressableAssetsData/link.xml*
/EmberFrameWork/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /EmberFrameWork/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/EmberFrameWork/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/EmberFrameWork/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/EmberFrameWork/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/EmberFrameWork/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/EmberFrameWork/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/EmberFrameWork/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/EmberFrameWork/UIElementsSchema/

# Auto-generated cache in Assets folder
/EmberFrameWork/[Aa]ssets/[Ss]ceneDependencyCache*

# Local Unity-MCP settings can contain a machine-specific token.
EmberFrameWork/UserSettings/AI-Game-Developer-Config.json

# The local MCP port depends on this checkout's path.
/.codex/config.toml
EmberFrameWork/.codex/config.toml
/EmberFrameWork/.idea/
EmberFrameWork/UserSettings/Layouts
